# HackOS Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://hackos:hackos_secret@localhost:5432/hackos?schema=public
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=30m

# Next.js / Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production-use-long-random-string
AUTH_SECRET=change-me-in-production-use-long-random-string
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# OAuth (optional for Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email (required for account verification and recovery)
# Use a local Mailpit/MailHog capture server during development.
# Set SMTP_HOST=localhost and SMTP_PORT=1025; never use real recipients for tests.
WEB_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@hackos.app

# Storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase (optional)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Redis email queue; generate a separate base64-encoded 32-byte encryption key.
MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_KEY=

# Optional production-only Gmail API (send-only, separate from Google sign-in).
# Consent scope: https://www.googleapis.com/auth/gmail.send
# Keep all credential values in deployment secrets, never source control.
GMAIL_SEND_CLIENT_ID=
GMAIL_SEND_CLIENT_SECRET=
GMAIL_SEND_REFRESH_TOKEN=

# Custom UPI: disabled by default. Production collection is unavailable.
MANUAL_UPI_ENABLED=false
FAMAPP_SANDBOX_ENABLED=false
FAMAPP_PERSONAL_TEST_AUTHORIZED=false
UPI_SYNTHETIC_MODE=false
UPI_TEST_PARTICIPANT_EMAILS=
MANUAL_UPI_TEST_ID=
FAMAPP_TEST_UPI_ID=
# Reserved for a future approved commercial release; not used for collection.
UPI_PRODUCTION_COLLECTION_ID=
# Separate random base64 32-byte encryption/HMAC key. Back up securely; rotation needs re-encryption.
UPI_RECONCILIATION_KEY=
UPI_RECONCILIATION_WORKER_ENABLED=false
PAYMENT_WORKER_ENABLED=false
# Dedicated read-only OAuth client; never reuse Gmail send credentials.
GMAIL_RECONCILIATION_ENABLED=false
GMAIL_RECONCILIATION_CLIENT_ID=
GMAIL_RECONCILIATION_CLIENT_SECRET=
GMAIL_RECONCILIATION_REDIRECT_URI=http://localhost:3000/admin/payments
GMAIL_RECONCILIATION_ALLOWED_MAILBOXES=
GMAIL_RECONCILIATION_ALLOWED_SENDERS=
GMAIL_RECONCILIATION_LABEL_ID=

# Create this exact label in the permitted mailbox; discover its ID after OAuth.
GMAIL_RECONCILIATION_LABEL_NAME=NIRAL Payment Alerts
# FamApp template parsing remains opt-in until sender authentication is independently checked.
GMAIL_RECONCILIATION_FAMAPP_TEMPLATE_ENABLED=false
# Server-verified mapping of permitted mailbox addresses to receiving test UPI IDs.
GMAIL_RECONCILIATION_BENEFICIARIES={}
GMAIL_RECONCILIATION_BENEFICIARY_VERIFIED=false
