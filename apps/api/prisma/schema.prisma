// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  VISITOR
  PARTICIPANT
  TEAM_LEADER
  MENTOR
  JUDGE
  VOLUNTEER
  SPONSOR
  ORGANIZER
  ADMIN
}

enum TeamStatus {
  FORMING
  ACTIVE
  SUBMITTED
  DISQUALIFIED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SCORED
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum QuizCategory {
  GENERAL
  PROGRAMMING
  IOT
  AI
  EMBEDDED
  NETWORKING
  CYBERSECURITY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  name          String
  image         String?
  role          UserRole  @default(PARTICIPANT)
  bio           String?
  college       String?
  department    String?
  xp            Int       @default(0)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  teamMemberships TeamMember[]
  ledTeams      Team[]    @relation("TeamLeader")
  notifications Notification[]
  quizAttempts  QuizAttempt[]
  achievements  UserAchievement[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([xp])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Event {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  isActive    Boolean  @default(true)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams       Team[]
  quizzes     Quiz[]
  announcements Announcement[]

  @@map("events")
}

model Team {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  status      TeamStatus @default(FORMING)
  inviteCode  String     @unique @default(cuid())
  eventId     String?
  leaderId    String?
  mentorId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event       Event?     @relation(fields: [eventId], references: [id])
  leader      User?      @relation("TeamLeader", fields: [leaderId], references: [id])
  members     TeamMember[]
  submission  Submission?
  sharedNotes SharedNote[]

  @@index([status])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Submission {
  id          String           @id @default(cuid())
  teamId      String           @unique
  title       String
  description String?          @db.Text
  githubUrl   String?
  demoUrl     String?
  status      SubmissionStatus @default(DRAFT)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  team   Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  files  SubmissionFile[]
  scores JudgeScore[]

  @@map("submissions")
}

model SubmissionFile {
  id           String   @id @default(cuid())
  submissionId String
  name         String
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_files")
}

model JudgeScore {
  id           String   @id @default(cuid())
  submissionId String
  judgeId      String
  innovation   Float    @default(0)
  technical    Float    @default(0)
  presentation Float    @default(0)
  scalability  Float    @default(0)
  impact       Float    @default(0)
  ui           Float    @default(0)
  business     Float    @default(0)
  comments     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeId])
  @@map("judge_scores")
}

model Quiz {
  id          String         @id @default(cuid())
  eventId     String?
  title       String
  description String?
  category    QuizCategory   @default(GENERAL)
  difficulty  QuizDifficulty @default(MEDIUM)
  timeLimit   Int            @default(600)
  xpReward    Int            @default(50)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  event     Event?        @relation(fields: [eventId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  prompt        String   @db.Text
  options       Json
  correctIndex  Int
  explanation   String?  @db.Text
  points        Int      @default(10)
  order         Int      @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  score       Int      @default(0)
  maxScore    Int
  answers     Json
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, score])
  @@map("quiz_attempts")
}

model SharedNote {
  id        String   @id @default(cuid())
  teamId    String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("shared_notes")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String   @default("info")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Announcement {
  id        String   @id @default(cuid())
  eventId   String?
  title     String
  body      String   @db.Text
  priority  String   @default("normal")
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  event Event? @relation(fields: [eventId], references: [id])

  @@map("announcements")
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String?
  xpReward    Int    @default(25)

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}
